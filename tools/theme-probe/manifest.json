{
  "manifestVersion": 5,
  "id": "com.lumiform.themeprobe",
  "name": "Lumiform Theme Probe",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "lumiformThemeProbe",
      "label": {
        "default": "Lumiform Theme Probe"
      },
      "minimumSize": {
        "width": 300,
        "height": 400
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 860
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 920
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
